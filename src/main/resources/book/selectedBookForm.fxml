<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/23.0.2"
      fx:controller="ee.ivkhkdev.nptv23javafx.controller.SelectedBookFormController"
      spacing="10" alignment="CENTER" style="-fx-padding: 20;">

    <Label text="Информация о книге" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <!-- ImageView для картинки книги -->
    <ImageView fx:id="bookImageView" fitWidth="200" preserveRatio="true"/>

    <Label text="Название:" style="-fx-font-weight: bold;"/>
    <Label fx:id="titleLabel"/>

    <Label text="Авторы:" style="-fx-font-weight: bold;"/>
    <Label fx:id="authorsLabel"/>

    <Label text="Год публикации:" style="-fx-font-weight: bold;"/>
    <Label fx:id="publicationYearLabel"/>

    <Label text="Всего экземпляров:" style="-fx-font-weight: bold;"/>
    <Label fx:id="quantityLabel"/>

    <Label text="В наличии:" style="-fx-font-weight: bold;"/>
    <Label fx:id="countLabel"/>

    <Button fx:id="readBookButton" text="Читать книгу" onAction="#handleReadBook"/>
    <Button fx:id="returnBookButton" text="Вернуть книгу" onAction="#handleReturnBook"/>
</VBox>
