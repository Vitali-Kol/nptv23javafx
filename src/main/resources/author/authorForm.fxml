<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="vbAuthorFormRoot" prefHeight="236.0" prefWidth="602.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demofx.controller.AuthorFormController">
    <children>
        <Label alignment="CENTER" prefHeight="89.0" prefWidth="600.0" text="Новый автор">
            <font>
                <Font size="18.0" />
            </font>
        </Label>
        <HBox prefHeight="28.0" prefWidth="600.0">
            <children>
                <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="161.0" text="Имя">
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Label>
                <TextField fx:id="firstNameField" prefHeight="25.0" prefWidth="308.0" promptText="Введите имя"/>
            </children>
        </HBox>
        <HBox prefHeight="28.0" prefWidth="600.0">
            <children>
                <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="161.0" text="Фамилия">
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Label>
                <TextField fx:id="lastNameField" prefHeight="25.0" prefWidth="308.0" promptText="Введите фамилию"/>
            </children>
        </HBox>
        <HBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="600.0">
            <children>
                <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="161.0">
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#create" prefHeight="25.0" prefWidth="125.0" text="Добавить" />
            </children>
        </HBox>
    </children>
</VBox>
